{
    "name": "__MSG_app_name__",
    "description": "__MSG_app_description__",
    "default_locale": "en",
    "version": "1.0",
    "manifest_version": 3,
    "browser_specific_settings": {
        "gecko": { "id": "jetphotos-helper@extension" }
    },
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_popup": "options/jp.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.jetphotos.com/addphotos*"
            ],
            "js": ["content.js"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://www.jetphotos.com/addphotos*"
            ],
            "js": ["options/jp.js"],
            "css": ["options/jp-content.css"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["page-hook.js", "airports.json"],
            "matches": ["https://www.jetphotos.com/*"]
        }
    ]
}
